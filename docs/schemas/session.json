{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aflock-ai/aflock/pkg/aflock/session-state",
  "$ref": "#/$defs/SessionState",
  "$defs": {
    "AIEvaluator": {
      "properties": {
        "name": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "prompt"
      ]
    },
    "ActionRecord": {
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "tool_name": {
          "type": "string"
        },
        "tool_use_id": {
          "type": "string"
        },
        "tool_input": true,
        "decision": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "timestamp",
        "tool_name",
        "tool_use_id",
        "decision"
      ]
    },
    "AllowDenyPolicy": {
      "properties": {
        "allow": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deny": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ArtifactMaterial": {
      "properties": {
        "name": {
          "type": "string"
        },
        "digest": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "uri": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name"
      ]
    },
    "CertConstraint": {
      "properties": {
        "commonName": {
          "type": "string"
        },
        "uris": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "DataFlowPolicy": {
      "properties": {
        "classify": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        },
        "flowRules": {
          "items": {
            "$ref": "#/$defs/DataFlowRule"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "DataFlowRule": {
      "properties": {
        "deny": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "deny"
      ]
    },
    "DomainsPolicy": {
      "properties": {
        "allow": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deny": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "EvaluatorsPolicy": {
      "properties": {
        "rego": {
          "items": {
            "$ref": "#/$defs/RegoEvaluator"
          },
          "type": "array"
        },
        "ai": {
          "items": {
            "$ref": "#/$defs/AIEvaluator"
          },
          "type": "array"
        },
        "grpc": {
          "items": {
            "$ref": "#/$defs/GRPCEvaluator"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "FilesPolicy": {
      "properties": {
        "allow": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deny": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "readOnly": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Functionary": {
      "properties": {
        "type": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "publickeyid": {
          "type": "string"
        },
        "spiffeId": {
          "type": "string"
        },
        "spiffeIdPattern": {
          "type": "string"
        },
        "trustDomain": {
          "type": "string"
        },
        "modelConstraint": {
          "type": "string"
        },
        "versionConstraint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type"
      ]
    },
    "GRPCEvaluator": {
      "properties": {
        "name": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "endpoint"
      ]
    },
    "GitMaterial": {
      "properties": {
        "treeHash": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "GrantsPolicy": {
      "properties": {
        "secrets": {
          "$ref": "#/$defs/AllowDenyPolicy"
        },
        "apis": {
          "$ref": "#/$defs/AllowDenyPolicy"
        },
        "storage": {
          "$ref": "#/$defs/AllowDenyPolicy"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "HooksConfig": {
      "properties": {
        "timeout": {
          "type": "integer"
        },
        "onPolicyViolation": {
          "type": "string"
        },
        "injectContext": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "IdentityPolicy": {
      "properties": {
        "allowedModels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowedEnvironments": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requiredTools": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Limit": {
      "properties": {
        "value": {
          "type": "number"
        },
        "enforcement": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "value"
      ]
    },
    "LimitsPolicy": {
      "properties": {
        "maxSpendUSD": {
          "$ref": "#/$defs/Limit"
        },
        "maxTokensIn": {
          "$ref": "#/$defs/Limit"
        },
        "maxTokensOut": {
          "$ref": "#/$defs/Limit"
        },
        "maxTurns": {
          "$ref": "#/$defs/Limit"
        },
        "maxWallTimeSeconds": {
          "$ref": "#/$defs/Limit"
        },
        "maxToolCalls": {
          "$ref": "#/$defs/Limit"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "MaterialClassification": {
      "properties": {
        "label": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "digest": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "label",
        "source",
        "timestamp"
      ]
    },
    "MaterialsPolicy": {
      "properties": {
        "session": {
          "$ref": "#/$defs/SessionMaterial"
        },
        "git": {
          "$ref": "#/$defs/GitMaterial"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactMaterial"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Policy": {
      "properties": {
        "version": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "expires": {
          "type": "string",
          "format": "date-time"
        },
        "roots": {
          "additionalProperties": {
            "$ref": "#/$defs/Root"
          },
          "type": "object"
        },
        "steps": {
          "additionalProperties": {
            "$ref": "#/$defs/Step"
          },
          "type": "object"
        },
        "identity": {
          "$ref": "#/$defs/IdentityPolicy"
        },
        "grants": {
          "$ref": "#/$defs/GrantsPolicy"
        },
        "limits": {
          "$ref": "#/$defs/LimitsPolicy"
        },
        "tools": {
          "$ref": "#/$defs/ToolsPolicy"
        },
        "files": {
          "$ref": "#/$defs/FilesPolicy"
        },
        "domains": {
          "$ref": "#/$defs/DomainsPolicy"
        },
        "dataFlow": {
          "$ref": "#/$defs/DataFlowPolicy"
        },
        "hooks": {
          "$ref": "#/$defs/HooksConfig"
        },
        "sublayouts": {
          "items": {
            "$ref": "#/$defs/Sublayout"
          },
          "type": "array"
        },
        "requiredAttestations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "attestationDir": {
          "type": "string"
        },
        "attestationsFrom": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "materialsFrom": {
          "$ref": "#/$defs/MaterialsPolicy"
        },
        "evaluators": {
          "$ref": "#/$defs/EvaluatorsPolicy"
        },
        "functionaries": {
          "items": {
            "$ref": "#/$defs/Functionary"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "version",
        "name"
      ]
    },
    "RegoEvaluator": {
      "properties": {
        "name": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "policy"
      ]
    },
    "RegoPolicy": {
      "properties": {
        "name": {
          "type": "string"
        },
        "module": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "module"
      ]
    },
    "Root": {
      "properties": {
        "certificate": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "certificate"
      ]
    },
    "SessionMaterial": {
      "properties": {
        "path": {
          "type": "string"
        },
        "merkleRoot": {
          "type": "string"
        },
        "algorithm": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "SessionMetrics": {
      "properties": {
        "tokensIn": {
          "type": "integer"
        },
        "tokensOut": {
          "type": "integer"
        },
        "costUSD": {
          "type": "number"
        },
        "turns": {
          "type": "integer"
        },
        "toolCalls": {
          "type": "integer"
        },
        "tools": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "filesRead": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "filesWritten": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "tokensIn",
        "tokensOut",
        "costUSD",
        "turns",
        "toolCalls",
        "tools"
      ]
    },
    "SessionState": {
      "properties": {
        "session_id": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "policy_path": {
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/SessionMetrics"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/ActionRecord"
          },
          "type": "array"
        },
        "materials": {
          "items": {
            "$ref": "#/$defs/MaterialClassification"
          },
          "type": "array"
        },
        "parent_session_id": {
          "type": "string"
        },
        "child_session_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "session_id",
        "started_at",
        "metrics"
      ]
    },
    "Step": {
      "properties": {
        "name": {
          "type": "string"
        },
        "functionaries": {
          "items": {
            "$ref": "#/$defs/StepFunctionary"
          },
          "type": "array"
        },
        "attestations": {
          "items": {
            "$ref": "#/$defs/StepAttestation"
          },
          "type": "array"
        },
        "artifactsFrom": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "functionaries",
        "attestations"
      ]
    },
    "StepAttestation": {
      "properties": {
        "type": {
          "type": "string"
        },
        "regopolicies": {
          "items": {
            "$ref": "#/$defs/RegoPolicy"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type"
      ]
    },
    "StepFunctionary": {
      "properties": {
        "type": {
          "type": "string"
        },
        "certConstraint": {
          "$ref": "#/$defs/CertConstraint"
        },
        "publickeyid": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type"
      ]
    },
    "Sublayout": {
      "properties": {
        "name": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "policyDigest": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "functionaries": {
          "items": {
            "$ref": "#/$defs/Functionary"
          },
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/LimitsPolicy"
        },
        "inherit": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "attestationPrefix": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "policy"
      ]
    },
    "ToolsPolicy": {
      "properties": {
        "allow": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deny": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requireApproval": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "title": "session"
}
